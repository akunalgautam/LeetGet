# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=leetget

# Used to sign login sessions (JWTs). Set this to a long random string.
JWT_SECRET=replace_with_a_long_random_string
